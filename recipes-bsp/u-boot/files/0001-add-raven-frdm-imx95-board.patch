From: Raven Project <raven@local>
Subject: [PATCH] board: add isolated Raven FRDM-IMX95 baseline
Upstream-Status: Inappropriate [embedded specific]

Copy the board implementation and defconfig from NXP bb41975aeb4cbd153b49c9fd62da1d64cd65968d.
Retain NXP licensing and hardware defaults; register a separate target and DT.

diff --git a/arch/arm/mach-imx/imx9/Kconfig b/arch/arm/mach-imx/imx9/Kconfig
--- a/arch/arm/mach-imx/imx9/Kconfig
+++ b/arch/arm/mach-imx/imx9/Kconfig
@@ -256,6 +256,12 @@
 
 config TARGET_IMX95_15X15_EVK
 	bool "imx95_15x15_evk"
+	select IMX95
+	imply BOOTSTD_BOOTCOMMAND
+	imply BOOTSTD_FULL
+
+config TARGET_RAVEN_FRDM_IMX95
+	bool "Raven development platform on FRDM-IMX95"
 	select IMX95
 	imply BOOTSTD_BOOTCOMMAND
 	imply BOOTSTD_FULL
@@ -347,6 +353,7 @@
 source "board/nxp/imx94_orangebox/Kconfig"
 source "board/nxp/imx95_evk/Kconfig"
 source "board/nxp/imx95_frdm/Kconfig"
+source "board/raven/raven_frdm_imx95/Kconfig"
 source "board/nxp/imx952_evk/Kconfig"
 source "board/nxp/imx952_frdm/Kconfig"
 source "board/toradex/smarc-imx95/Kconfig"
diff --git a/arch/arm/dts/Makefile b/arch/arm/dts/Makefile
--- a/arch/arm/dts/Makefile
+++ b/arch/arm/dts/Makefile
@@ -1274,3 +1274,5 @@
 
 DTC_FLAGS_imx8mp-dhcom-som-overlay-rev100 += -Wno-avoid_default_addr_size -Wno-reg_format
 DTC_FLAGS_imx8mp-dhcom-pdk3-overlay-rev100 += -Wno-avoid_default_addr_size -Wno-reg_format
+
+dtb-$(CONFIG_TARGET_RAVEN_FRDM_IMX95) += raven-frdm-imx95.dtb
diff --git a/board/raven/raven_frdm_imx95/raven_frdm_imx95.c b/board/raven/raven_frdm_imx95/raven_frdm_imx95.c
new file mode 100644
--- /dev/null
+++ b/board/raven/raven_frdm_imx95/raven_frdm_imx95.c
@@ -0,0 +1,669 @@
