<?xml version="1.0"?>
<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<!-- Host-only Gazebo scene. Actor asset: Mingfei/actor, Fuel version 1. -->
<sdf version="1.9">
  <world name="courtyard">
    <physics name="realtime" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libGstCameraSystem.so" name="custom::GstCameraSystem">
      <udpHost>127.0.0.1</udpHost>
      <udpPort>5602</udpPort>
      <useCuda>false</useCuda>
    </plugin>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.65 0.8 0.95 1</background>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -1</direction>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.4 0.45 0.35 1</ambient>
            <diffuse>0.4 0.45 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <actor name="person">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/1/files/meshes/walk.dae</filename>
        <scale>1</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/1/files/meshes/walk.dae</filename>
        <scale>1</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
          <waypoint>
            <time>0</time>
            <pose>-1 -2 1 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>20</time>
            <pose>2 -2 1 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>40</time>
            <pose>2 2 1 0 0 1.5708</pose>
          </waypoint>
          <waypoint>
            <time>60</time>
            <pose>-1 2 1 0 0 3.1416</pose>
          </waypoint>
          <waypoint>
            <time>80</time>
            <pose>-1 -2 1 0 0 4.7124</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>
    <model name="camera">
      <static>true</static>
      <pose>-6 0 1.6 0 0.05 0</pose>
      <link name="link">
        <sensor name="rgb" type="camera">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.0472</horizontal_fov>
            <image>
              <width>640</width>
              <height>360</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>50</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>
    <model name="rear_wall">
      <static>true</static>
      <pose>5 0 1.5 0 0 0</pose>
      <link name="body">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 16 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.65 0.62 0.52 1</ambient>
            <diffuse>0.65 0.62 0.52 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="crate_left">
      <static>true</static>
      <pose>1 4 0.4 0 0 0</pose>
      <link name="body">
        <visual name="visual">
          <geometry>
            <box>
              <size>1 1 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.3 0.12 1</ambient>
            <diffuse>0.55 0.3 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="crate_right">
      <static>true</static>
      <pose>2 -4 0.4 0 0 0</pose>
      <link name="body">
        <visual name="visual">
          <geometry>
            <box>
              <size>1 1 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.3 0.12 1</ambient>
            <diffuse>0.55 0.3 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>