<?xml version="1.0"?>
<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<!-- Open Robotics Fuel assets are CC0; numeric URI versions pin the scene assets.
     The actor trajectory supplies scripted visual motion, not road-vehicle dynamics.
     occluder_tree starts outside view and can be moved with the Gazebo set_pose service. -->
<sdf version="1.9">
  <world name="street">
    <physics name="realtime" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libGstCameraSystem.so" name="custom::GstCameraSystem">
      <udpHost>127.0.0.1</udpHost>
      <udpPort>5602</udpPort>
      <useCuda>false</useCuda>
    </plugin>
