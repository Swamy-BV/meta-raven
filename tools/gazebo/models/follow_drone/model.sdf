<?xml version="1.0"?>
<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<!-- Uses the x500 from the firmware-matched PX4 simulation assets. -->
<sdf version="1.9">
  <model name="follow_drone">
    <include merge="true"><uri>model://x500</uri></include>
    <link name="camera_link">
      <pose relative_to="base_link">0.2 0 0.1 0 0.3 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
      <sensor name="rgb" type="camera">
        <always_on>true</always_on><update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.4</horizontal_fov>
          <image><width>640</width><height>360</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>80</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="camera_mount" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>
  </model>
</sdf>
