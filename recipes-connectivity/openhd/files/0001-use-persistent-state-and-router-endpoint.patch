+        if (m_fc_udp && component == m_ohd_main_component) {
+          // Standard heartbeat registration also recovers after router restarts.
+          for (const auto& message : messages) {
+            if (message.m.msgid == MAVLINK_MSG_ID_HEARTBEAT) {
+              m_fc_udp->sendMessages({message});
