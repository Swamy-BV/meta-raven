-  setup_uart();
+  const auto* fc_udp = std::getenv("OPENHD_FC_UDP");
+  if (fc_udp != nullptr && std::strcmp(fc_udp, "1") == 0) {
+    // Router listens on 14563; OpenHD listens on 14562. Both are loopback only.
+    m_fc_udp = std::make_unique<UDPEndpoint>("fc_udp", 14563, 14562);
+    m_fc_udp->registerCallback([this](std::vector<MavlinkMessage> messages) {
+      on_messages_fc(messages);
+    });
+  } else {
+    setup_uart();
+  }
   setup_openhd_uart_telemetry();
   m_console->debug("Created AirTelemetry");
 }
@@ -74,7 +85,11 @@ void AirTelemetry::send_messages_fc(std::vector<MavlinkMessage>& messages) {
       split_into_generic_and_local_only(messages, OHD_SYS_ID_AIR);
   // NOTE: Remember there is a hack in place for rc channels override in regards
   // to the sender sys id
-  m_fc_serial->send_messages_if_enabled(generic);
+  if (m_fc_udp) {
+    m_fc_udp->sendMessages(generic);
+  } else {
+    m_fc_serial->send_messages_if_enabled(generic);
+  }
 }
 
