Subject: [PATCH] Use CMake's LibLZMA module when cross compiling

Adding HINTS switches find_package to config mode, but Yocto's xz recipe
provides headers/libraries rather than a LibLZMAConfig.cmake. The standard
FindLibLZMA module already respects the toolchain's sysroot search rules.

Upstream-Status: Pending

--- a/cpp/src/CMakeLists.txt
+++ b/cpp/src/CMakeLists.txt
@@ -44,11 +44,7 @@
 if(NOT BUILD_WITHOUT_CURL)
     find_package(CURL REQUIRED)
 endif()
-if (CMAKE_CROSSCOMPILING)
-    find_package(LibLZMA HINTS "${CMAKE_PREFIX_PATH}" REQUIRED)
-else()
-    find_package(LibLZMA REQUIRED)
-endif()
+find_package(LibLZMA REQUIRED)
 
 if(BUILD_TESTING AND (IOS OR ANDROID))
     message(STATUS "Building for iOS or Android: forcing BUILD_TESTING to FALSE...")
