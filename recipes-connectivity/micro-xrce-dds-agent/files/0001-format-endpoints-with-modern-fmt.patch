Subject: [PATCH] logger: explicitly stream endpoint values with modern fmt

fmt 10 and later no longer implicitly format types with ostream operators.
Wrap endpoint log arguments with fmt::streamed, preserving the agent's
existing endpoint representation and keeping diagnostics enabled.

Upstream-Status: Pending
Signed-off-by: Swamy-BV <74085717+Swamy-BV@users.noreply.github.com>
---
diff --git a/include/uxr/agent/transport/SessionManager.hpp b/include/uxr/agent/transport/SessionManager.hpp
index 3681fc7..11f7bfe 100644
--- a/include/uxr/agent/transport/SessionManager.hpp
+++ b/include/uxr/agent/transport/SessionManager.hpp
@@ -75,7 +75,7 @@ void SessionManager<EndPoint>::establish_session(
             UXR_DECORATE_GREEN("session re-established"),
             "client_key: 0x{:08X}, address: {}",
             client_key,
-            endpoint);
+            fmt::streamed(endpoint));
     }
     else
     {
@@ -84,7 +84,7 @@ void SessionManager<EndPoint>::establish_session(
             UXR_DECORATE_GREEN("session established"),
             "client_key: 0x{:08X}, address: {}",
             client_key,
-            endpoint);
+            fmt::streamed(endpoint));
     }

     if (!has_session_client_key(session_id))
@@ -114,7 +114,7 @@ void SessionManager<EndPoint>::destroy_session(
             UXR_DECORATE_GREEN("session closed"),
             "client_key: 0x{:08X}, address: {}",
             it->second,
-            endpoint);
+            fmt::streamed(endpoint));
         client_to_endpoint_map_.erase(it->second);
         endpoint_to_client_map_.erase(it->first);
     }
@@ -133,7 +133,7 @@ void SessionManager<EndPoint>::destroy_session(
             UXR_DECORATE_GREEN("session closed"),
             "client_key: 0x{:08X}, address: {}",
             client_key,
-            it->second);
+            fmt::streamed(it->second));
         endpoint_to_client_map_.erase(it->second);
         client_to_endpoint_map_.erase(it->first);
     }
