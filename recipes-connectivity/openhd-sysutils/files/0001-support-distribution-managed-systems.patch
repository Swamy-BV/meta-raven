From: Raven Developers <raven@localhost>
Subject: [PATCH] Support distribution-managed systems and persistent configuration

Upstream-Status: Inappropriate [configuration]
Signed-off-by: Raven Developers <raven@localhost>

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 7e61e11..bb02aad 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,5 +1,10 @@
 cmake_minimum_required(VERSION 3.10)
 project(openhd_sys_utils VERSION 1.0.3 LANGUAGES CXX)
+option(OPENHD_MANAGED_SYSTEM "Manage host storage, updates and services" ON)
+if(OPENHD_MANAGED_SYSTEM)
+    add_compile_definitions(OPENHD_MANAGED_SYSTEM)
+endif()
+include(GNUInstallDirs)
 
 set(CMAKE_CXX_STANDARD 17)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
@@ -15,7 +20,7 @@ if(CMAKE_CROSSCOMPILING)
     # If cross-compiling, assume 'c++' is the host compiler if not specified via HOST_CXX.
     # Users can set HOST_CXX to point to their native compiler.
     if(DEFINED ENV{HOST_CXX})
-        set(HOST_CXX_COMPILER $ENV{HOST_CXX})
+        separate_arguments(HOST_CXX_COMPILER NATIVE_COMMAND "$ENV{HOST_CXX}")
     else()
         set(HOST_CXX_COMPILER "c++")
     endif()
@@ -127,24 +132,7 @@ add_custom_target(update_build_version ALL
 add_dependencies(openhd_sys_utils update_build_version)
 target_sources(openhd_sys_utils PRIVATE ${GENERATED_VERSION_HEADER})
 
-install(TARGETS openhd_sys_utils
-    RUNTIME DESTINATION /usr/local/bin
-)
-
-install(
-    PROGRAMS ${CMAKE_CURRENT_SOURCE_DIR}/sbin/openhd-rk3566-bookworm-splash-setup
-    DESTINATION /usr/local/sbin
-)
-
-install(
-    FILES ${CMAKE_CURRENT_SOURCE_DIR}/systemd/openhd-sys-utils.service
-    DESTINATION /lib/systemd/system
-)
-
-install(
-    PROGRAMS ${CMAKE_CURRENT_SOURCE_DIR}/init.d/openhd-sys-utils
-    DESTINATION /etc/init.d
-)
+install(TARGETS openhd_sys_utils RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
 
 if(OPENHD_X20_PACKAGE)
     install(
diff --git a/src/openhd_sys_utils.cpp b/src/openhd_sys_utils.cpp
index a0b06d3..3b68582 100644
--- a/src/openhd_sys_utils.cpp
+++ b/src/openhd_sys_utils.cpp
@@ -223,6 +223,21 @@ bool handleClientData(int fd, std::unordered_map<int, std::string>& buffers) {
                 if (gDebug) {
                     std::cout << "sysutils <= " << line << std::endl;
                 }
+#ifndef OPENHD_MANAGED_SYSTEM
+                // Only read APIs and settings persistence belong to this daemon.
+                const auto request_type = sysutil::extract_string_field(line, "type");
+                if (request_type && request_type->rfind("sysutil.", 0) == 0 &&
+                    *request_type != "sysutil.platform.request" &&
+                    *request_type != "sysutil.settings.request" &&
+                    *request_type != "sysutil.settings.update" &&
+                    *request_type != "sysutil.wifi.request" &&
+                    *request_type != "sysutil.debug.request" &&
+                    *request_type != "sysutil.status.request") {
+                    (void)sendAll(fd, "{\"type\":\"sysutil.error\",\"ok\":false,"
+                                     "\"message\":\"Managed by distribution\"}\n");
+                    continue;
+                }
+#endif
                 if (sysutil::is_platform_request(line)) {
                     const auto response = sysutil::build_platform_response();
                     if (gDebug) {
@@ -366,11 +381,16 @@ int main(int argc, char* argv[]) {
             return 0;
         }
         if (arg == "-p") {
+#ifndef OPENHD_MANAGED_SYSTEM
+            std::cerr << "Storage is managed by the distribution." << std::endl;
+            return 1;
+#else
             if (!sysutil::resize_partition()) {
                 std::cerr << "Partitioning task failed." << std::endl;
                 return 1;
             }
             return 0;
+#endif
         }
         if (arg == "-d") {
             gDebug = true;
@@ -386,23 +406,31 @@ int main(int argc, char* argv[]) {
         return 1;
     }
 
+#ifdef OPENHD_MANAGED_SYSTEM
     remove_space_image();
     sysutil::init_leds();
+#endif
     sysutil::set_status("sysutils.started", "Sysutils started",
                         "Waiting for OpenHD requests.");
     sysutil::init_platform_info();
+#ifdef OPENHD_MANAGED_SYSTEM
     sysutil::start_openhd_glide_early_if_needed();
     sysutil::run_firstboot_tasks();
     sysutil::mount_known_partitions();
     sysutil::sync_settings_from_files();
     sysutil::init_update_worker();
+#endif
     sysutil::init_wifi_info();
+#ifdef OPENHD_MANAGED_SYSTEM
     sysutil::link_serial_ports();
+#endif
     sysutil::init_debug_info();
     gDebug = gDebug || sysutil::debug_enabled();
+#ifdef OPENHD_MANAGED_SYSTEM
     sysutil::apply_hostname_if_enabled();
     sysutil::start_openhd_services_if_needed();
     sysutil::start_ground_video_if_needed();
+#endif
     bool wifi_retry_active = !sysutil::has_openhd_wifibroadcast_cards();
     std::size_t wifi_retry_attempt = 0;
     if (wifi_retry_active) {
diff --git a/src/sysutil_config.cpp b/src/sysutil_config.cpp
index cb20961..af8ac01 100644
--- a/src/sysutil_config.cpp
+++ b/src/sysutil_config.cpp
@@ -34,7 +34,7 @@ namespace {
 
 // Sysutils config location on the target system.
 constexpr const char* kConfigPath =
-    "/usr/local/share/OpenHD/SysUtils/config.json";
+    "/var/lib/openhd/sysutils.json";
 
 // Escapes JSON string content for output.
 std::string json_escape(const std::string& input) {
diff --git a/src/sysutil_debug.cpp b/src/sysutil_debug.cpp
index 6c572f1..3518a79 100644
--- a/src/sysutil_debug.cpp
+++ b/src/sysutil_debug.cpp
@@ -41,7 +41,7 @@ constexpr const char* kDebugFilePaths[] = {
     "/boot/openhd/debug.txt",
 };
 // Persistent OpenHD debug marker for log verbosity.
-constexpr const char* kOpenhdDebugMarker = "/usr/local/share/openhd/debug.txt";
+constexpr const char* kOpenhdDebugMarker = "/var/lib/openhd/debug.txt";
 
 // Cached debug state for this process.
 std::optional<bool> g_debug_enabled;
diff --git a/src/sysutil_settings.cpp b/src/sysutil_settings.cpp
index e07e1e2..0013d23 100644
--- a/src/sysutil_settings.cpp
+++ b/src/sysutil_settings.cpp
@@ -750,6 +750,7 @@ std::string handle_settings_update(const std::string& line) {
   if (changed) {
     ok = write_sysutil_config(config);
   }
+#ifdef OPENHD_MANAGED_SYSTEM
   if (ok && debug_changed) {
     const bool restart_openhd =
         !config.disable_openhd_service.value_or(false);
@@ -759,6 +760,7 @@ std::string handle_settings_update(const std::string& line) {
     apply_hostname_if_enabled();
   }
 
+#endif
   std::ostringstream out;
   out << "{\"type\":\"sysutil.settings.update.response\",\"ok\":"
       << (ok ? "true" : "false") << "}\n";
diff --git a/src/sysutil_wifi.cpp b/src/sysutil_wifi.cpp
index 0ab8b12..29e74f3 100644
--- a/src/sysutil_wifi.cpp
+++ b/src/sysutil_wifi.cpp
@@ -56,11 +56,11 @@ namespace sysutil {
 namespace {
 
 constexpr const char* kOverridesPath =
-    "/usr/local/share/OpenHD/SysUtils/wifi_overrides.conf";
+    "/var/lib/openhd/wifi_overrides.conf";
 constexpr const char* kTxPowerOverridesPath =
-    "/usr/local/share/OpenHD/SysUtils/wifi_txpower.conf";
+    "/var/lib/openhd/wifi_txpower.conf";
 constexpr const char* kWifiCardsPath =
-    "/usr/local/share/OpenHD/SysUtils/wifi_cards.json";
+    "/var/lib/openhd/wifi_cards.json";
 constexpr const char* kOpenHdControlSocketPath =
     "/run/openhd/openhd_ctrl.sock";
 constexpr std::size_t kMaxControlLineLength = 4096;
diff --git a/tools/increment_build_version.cmake b/tools/increment_build_version.cmake
index 5d7ce6b..559d956 100644
--- a/tools/increment_build_version.cmake
+++ b/tools/increment_build_version.cmake
@@ -10,6 +10,12 @@ if(NOT DEFINED BASE_VERSION)
     message(FATAL_ERROR "BASE_VERSION is not set")
 endif()
 
+if(DEFINED ENV{SOURCE_DATE_EPOCH})
+    file(WRITE "${OUTPUT_HEADER}"
+         "#pragma once\n#define OPENHD_SYS_UTILS_VERSION \"${BASE_VERSION}\"\n")
+    return()
+endif()
+
 set(_openhd_build_ver "")
 
 if(DEFINED ENV{OPENHD_BUILD_NUMBER} AND NOT "$ENV{OPENHD_BUILD_NUMBER}" STREQUAL "")
