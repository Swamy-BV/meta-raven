[Unit]
Description=Prepare shared writable state for both Raven slots
DefaultDependencies=no
Requires=overlay.mount
After=overlay.mount systemd-remount-fs.service
Before=var-lib.mount

[Service]
Type=oneshot
ExecStart=/bin/mkdir -p /overlay/upper/var/lib /overlay/workdir/var/lib
RemainAfterExit=yes
