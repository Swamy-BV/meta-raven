software = {
    version = "@@PV@@";
    description = "Raven Linux A/B and shared i.MX boot-container update";

    hardware-compatibility: [ "1.0" ];
    stable = {
        slot_a = {
            bootenv: (
                { name = "bootslot"; value = "dualA"; },
                { name = "upgrade_available"; value = "1"; },
                { name = "bootcount"; value = "0"; },
                { name = "bootlimit"; value = "3"; }
            );
            files: (
                {
                    filename = "Image";
                    path = "/Image";
                    device = "/dev/disk/by-partlabel/boot_a";
                    filesystem = "vfat";
                    sha256 = "$swupdate_get_sha256(Image)";
                },
                {
                    filename = "@@RAVEN_CAMERA_DTB@@";
                    path = "/@@RAVEN_CAMERA_DTB@@";
                    device = "/dev/disk/by-partlabel/boot_a";
                    filesystem = "vfat";
                    sha256 = "$swupdate_get_sha256(@@RAVEN_CAMERA_DTB@@)";
                }
            );
            images: (
                {
                    filename = "raven-image-raven-frdm-imx95.rootfs.ext4.gz";
                    type = "raw";
                    compressed = "zlib";
                    device = "/dev/disk/by-partlabel/rootfs_a";
                    installed-directly = true;
                    sha256 = "$swupdate_get_sha256(raven-image-raven-frdm-imx95.rootfs.ext4.gz)";
                },
                {
                    filename = "@@RAVEN_IMX_BOOT_IMAGE@@";
                    type = "raw";
                    device = "/dev/mmcblk0";
                    offset = "@@RAVEN_IMX_BOOT_OFFSET@@";
                    sha256 = "$swupdate_get_sha256(@@RAVEN_IMX_BOOT_IMAGE@@)";
                }
            );
        };
        slot_b = {
            bootenv: (
                { name = "bootslot"; value = "dualB"; },
                { name = "upgrade_available"; value = "1"; },
                { name = "bootcount"; value = "0"; },
                { name = "bootlimit"; value = "3"; }
            );
            files: (
                {
                    filename = "Image";
                    path = "/Image";
                    device = "/dev/disk/by-partlabel/boot_b";
                    filesystem = "vfat";
                    sha256 = "$swupdate_get_sha256(Image)";
                },
                {
                    filename = "@@RAVEN_CAMERA_DTB@@";
                    path = "/@@RAVEN_CAMERA_DTB@@";
                    device = "/dev/disk/by-partlabel/boot_b";
                    filesystem = "vfat";
                    sha256 = "$swupdate_get_sha256(@@RAVEN_CAMERA_DTB@@)";
                }
            );
            images: (
                {
                    filename = "raven-image-raven-frdm-imx95.rootfs.ext4.gz";
                    type = "raw";
                    compressed = "zlib";
                    device = "/dev/disk/by-partlabel/rootfs_b";
                    installed-directly = true;
                    sha256 = "$swupdate_get_sha256(raven-image-raven-frdm-imx95.rootfs.ext4.gz)";
                },
                {
                    filename = "@@RAVEN_IMX_BOOT_IMAGE@@";
                    type = "raw";
                    device = "/dev/mmcblk0";
                    offset = "@@RAVEN_IMX_BOOT_OFFSET@@";
                    sha256 = "$swupdate_get_sha256(@@RAVEN_IMX_BOOT_IMAGE@@)";
                }
            );
        };
    };
}
