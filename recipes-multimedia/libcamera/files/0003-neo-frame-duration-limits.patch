+/* Convert duration requests to sensor lines without exceeding sensor limits. */
+void Agc::queueFrameDuration(IPAContext &context, IPAFrameContext &frameContext,
+			     const ControlList &controls)
+{
+	const auto &sensor = context.configuration.sensor;
+	auto &active = context.activeState.frameDuration;
+	const auto &limits = controls.get(controls::FrameDurationLimits);
+	if (limits) {
+		const auto frameLength = [&sensor](int64_t duration) {
+			if (!duration)
+				return sensor.size.height + sensor.defVBlank;
+			double lines = std::ceil(duration * 1.0us / sensor.lineDuration);
+			return static_cast<uint32_t>(std::clamp(lines,
+				static_cast<double>(sensor.size.height + sensor.minVBlank),
+				static_cast<double>(sensor.size.height + sensor.maxVBlank)));
+		};
+		active.minFrameLength = frameLength(limits->front());
+		active.maxFrameLength = std::max(active.minFrameLength,
+					       frameLength(limits->back()));
+	}
+	frameContext.frameDuration = { active.minFrameLength, active.maxFrameLength };
+}
