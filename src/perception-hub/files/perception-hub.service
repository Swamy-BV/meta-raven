[Unit]
Description=Raven inference outputs and model metadata
After=model-runner.service
Requires=model-runner.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
# The existing private runner socket authorizes this account.
User=model-runner
Group=model-runner
LogsDirectory=perception
Environment=ROS_LOG_DIR=/var/log/perception
Environment=AMENT_PREFIX_PATH=@ROS_PREFIX@
Environment=LD_LIBRARY_PATH=@ROS_PREFIX@/lib
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ExecStart=@ROS_PREFIX@/lib/perception_hub/perception-hub
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
DevicePolicy=closed
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
TasksMax=64
MemoryMax=128M
UMask=0077

[Install]
WantedBy=multi-user.target
