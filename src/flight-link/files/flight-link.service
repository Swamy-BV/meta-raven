[Unit]
Description=Raven read-only flight telemetry gateway
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=flight-link
Group=flight-link
StateDirectory=flight-link
LogsDirectory=flight-link
Environment=ROS_LOG_DIR=/var/log/flight-link
Environment=AMENT_PREFIX_PATH=@ROS_PREFIX@
Environment=LD_LIBRARY_PATH=@ROS_PREFIX@/lib
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ExecStart=@ROS_PREFIX@/lib/flight_link/flight-link
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
TasksMax=64
MemoryMax=256M
UMask=0077

[Install]
WantedBy=multi-user.target
