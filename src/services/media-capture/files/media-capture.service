[Unit]
Requires=raven-ros-shm.service
After=raven-ros-shm.service
JoinsNamespaceOf=raven-ros-shm.service
PartOf=raven-ros-shm.service
Description=ROS camera frames, photos, recording and streaming
After=network.target
RequiresMountsFor=/data
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=media-capture
Group=ros-shm
SupplementaryGroups=ros-shm
WorkingDirectory=/data/media-capture
LogsDirectory=media-capture
Environment=ROS_LOG_DIR=/var/log/media-capture
Environment=AMENT_PREFIX_PATH=@ROS_PREFIX@
Environment=LD_LIBRARY_PATH=@ROS_PREFIX@/lib
EnvironmentFile=/etc/ros/ros2.env
EnvironmentFile=/etc/ros/ros2-shm.env
ExecStart=@ROS_PREFIX@/lib/media_capture/media-capture --ros-args --params-file /etc/media-capture.yaml
Restart=on-failure
RestartSec=10
# Let libcamera stop its IPA workers before terminating the whole group.
KillMode=mixed
TimeoutStopSec=10
UMask=0077
RuntimeDirectory=media-capture
RuntimeDirectoryMode=0750
ReadWritePaths=/data/media-capture
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
DevicePolicy=closed
# Hardware capture requires an explicit local drop-in allowing its device.
MemoryMax=512M
TasksMax=64
CPUQuota=200%

[Install]
WantedBy=multi-user.target
