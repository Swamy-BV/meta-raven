+}
+// Transform the XYAH Kalman state after camera motion; aspect ratio stays
+// unchanged until a real measurement corrects viewpoint-dependent shape.
+void STrack::apply_camera_motion(const std::array<float, 6>& transform)
+{
+    const float scale = std::hypot(transform[0], transform[3]);
+    KAL_COVA jacobian = KAL_COVA::Identity();
+    for (int offset : {0, 4}) {
+        jacobian(offset, offset) = transform[0];
+        jacobian(offset, offset + 1) = transform[1];
+        jacobian(offset + 1, offset) = transform[3];
+        jacobian(offset + 1, offset + 1) = transform[4];
+    }
+    jacobian(3, 3) = scale;
+    jacobian(7, 7) = scale;
+    mean = (mean * jacobian.transpose()).eval();
+    mean[0] += transform[2];
+    mean[1] += transform[5];
+    covariance = (jacobian * covariance * jacobian.transpose()).eval();
+    static_tlwh();
+    static_tlbr();
+}
