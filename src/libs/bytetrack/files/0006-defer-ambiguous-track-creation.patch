From: Raven developers
Subject: [PATCH] Allow association policy to defer competing new identities

Keep all existing overloads and track layouts unchanged. A synchronous optional
creation predicate lets a caller defer a clipped or ambiguous observation near
a retained identity without accepting it as a verified recovery.

Upstream-Status: Pending
Signed-off-by: Raven developers <noreply@raven.local>

--- a/deploy/TensorRT/cpp/include/BYTETracker.h
+++ b/deploy/TensorRT/cpp/include/BYTETracker.h
@@ -26,6 +26,7 @@
 	vector<STrack> update(const vector<Object>& objects, double stamp_seconds, float step);
 	vector<STrack> update(const vector<Object>& objects, double stamp_seconds, float step, const AssociationHooks& hooks);
     vector<STrack> update(const vector<Object>& objects, double stamp_seconds, float step, const AssociationHooks& hooks, const std::function<void(STrack&, size_t)>& recover);
+    vector<STrack> update(const vector<Object>& objects, double stamp_seconds, float step, const AssociationHooks& hooks, const std::function<void(STrack&, size_t)>& recover, const std::function<bool(size_t)>& initialize);
     vector<int> retained_ids() const;
 	size_t size() const { return tracked_stracks.size() + lost_stracks.size(); }
 
--- a/deploy/TensorRT/cpp/src/BYTETracker.cpp
