From: Raven developers
Subject: [PATCH] Inject source-indexed appearance association without changing track layouts

Upstream-Status: Inappropriate [embedded specific]

Signed-off-by: Raven developers <noreply@raven.local>

--- a/deploy/TensorRT/cpp/include/BYTETracker.h
+++ b/deploy/TensorRT/cpp/include/BYTETracker.h
@@ -1,6 +1,14 @@
 #pragma once
 
 #include "STrack.h"
+#include <functional>
+
+// Hooks are synchronous for one update; indices refer to the original input objects.
+// Empty hooks preserve IoU association. Object and track memory layouts are unchanged.
+struct AssociationHooks {
+    std::function<void(vector<vector<float>>&, const vector<STrack*>&, const vector<STrack>&, const vector<size_t>&)> refine;
+    std::function<void(const STrack&, size_t)> measured;
+};
 
 struct Object
 {
@@ -16,6 +24,8 @@
 	~BYTETracker();
 
 	vector<STrack> update(const vector<Object>& objects, double stamp_seconds, float step);
+	vector<STrack> update(const vector<Object>& objects, double stamp_seconds, float step, const AssociationHooks& hooks);
+    vector<int> retained_ids() const;
 	size_t size() const { return tracked_stracks.size() + lost_stracks.size(); }
 
 private:
--- a/deploy/TensorRT/cpp/src/BYTETracker.cpp
+++ b/deploy/TensorRT/cpp/src/BYTETracker.cpp
@@ -19,6 +19,19 @@
 }
 
 vector<STrack> BYTETracker::update(const vector<Object>& objects, double stamp_seconds, float step)
+{
+    return update(objects, stamp_seconds, step, {});
+}
+
+vector<int> BYTETracker::retained_ids() const
+{
+    vector<int> result;
+    for (const auto& track : tracked_stracks) result.push_back(track.track_id);
+    for (const auto& track : lost_stracks) result.push_back(track.track_id);
+    return result;
+}
+
