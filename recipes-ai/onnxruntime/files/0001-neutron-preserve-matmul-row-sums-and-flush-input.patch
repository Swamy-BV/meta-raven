Subject: [PATCH] neutron: preserve MatMulIntegerToFloat row sums and flush input

Dynamic activation zero points must be applied to immutable weight row sums.
The previous implementation overwrote the sums with the current bias, so
subsequent invocations multiplied an already adjusted bias again. This
corrupts autoregressive decoding and repeated vision inference.

Retain row sums independently for raw and offline-packed weights, and use
them for both constant and dynamic activation zero points. Flush the copied
activation buffer before submitting it to Neutron, matching MatMulInteger.

Upstream-Status: Pending

diff --git a/onnxruntime/core/providers/neutron/ops/matmul_integer_to_float.cc b/onnxruntime/core/providers/neutron/ops/matmul_integer_to_float.cc
index 86bc2553b..bc9742563 100644
--- a/onnxruntime/core/providers/neutron/ops/matmul_integer_to_float.cc
+++ b/onnxruntime/core/providers/neutron/ops/matmul_integer_to_float.cc
@@ -189,7 +189,7 @@ Status MatMulIntegerToFloat::PrePack(const Tensor& tensor, int input_idx, Alloca
             m_compress_len = (int32_t*)((int8_t*)m_b_neutron    + ALIGN16_SIZE(weight_len));
             m_decode_input = (uint8_t*)((int8_t*)m_compress_len + ALIGN16_SIZE(compress_len));
 
-            // Store raw row_sum; bias will be computed dynamically in Compute
+            // Store raw row sums; retain a separate copy for subsequent invocations.
             memcpy(m_b_bias,    row_sum, bias_len);
             memcpy(m_b_factors, factors, factor_len);
             memcpy(m_b_neutron, pckOut.Bpacked->data, weight_len);
@@ -206,6 +206,8 @@ Status MatMulIntegerToFloat::PrePack(const Tensor& tensor, int input_idx, Alloca
             dyn8_free(pckOut.Bpacked);
             dyn32_free(pckOut.lengths);
           }
+          // Preserve row sums for both raw and offline-packed weights.
+          m_b_row_sum.assign(m_b_bias, m_b_bias + m_b_rows);
         }
         break;
       case IN_A_SCALE:
@@ -233,7 +235,7 @@ Status MatMulIntegerToFloat::PrePack(const Tensor& tensor, int input_idx, Alloca
           if (inline_prepacked_) {
             m_a_zp = *(static_cast<const uint8_t*>(tensor.DataRaw()));
             for (uint32_t i=0; i< m_b_rows; i++){
-              m_b_bias[i] = (int32_t)( - m_b_bias[i] * m_a_zp );
+              m_b_bias[i] = (int32_t)( - m_b_row_sum[i] * m_a_zp );
             }
             clean_cache(m_b_bias, m_b_rows*sizeof(int32_t));
 	  }
@@ -304,7 +306,7 @@ Status MatMulIntegerToFloat::Compute(OpKernelContext* ctx) const {
     if (m_dynamic_bias) {
         uint8_t a_zp = *(static_cast<const uint8_t*>(ctx->Input<Tensor>(IN_A_ZERO_POINT)->DataRaw()));
         for (uint32_t i=0; i< m_b_rows; i++) {
-            m_b_bias[i] = (int32_t)( - m_b_bias[i] * a_zp);
+            m_b_bias[i] = (int32_t)( - m_b_row_sum[i] * a_zp);
         }
         clean_cache(m_b_bias, m_b_rows*sizeof(int32_t));
     }
@@ -321,6 +323,7 @@ Status MatMulIntegerToFloat::Compute(OpKernelContext* ctx) const {
     uint8_t *a_neutron = (uint8_t *) neutronAlloc->AllocReserved(a_size, m_handle);
     auto  a_data = static_cast<const uint8_t*>(a->DataRaw());
     memcpy(a_neutron, a_data, a_size);
+    clean_cache(a_neutron, a_size);
 
     uint32_t y_size = neutron_a_rows * neutron_b_rows * num_matmuls * sizeof(int32_t);
     int32_t *y_neutron = (int32_t *) neutronAlloc->AllocReserved(y_size, m_handle);
diff --git a/onnxruntime/core/providers/neutron/ops/matmul_integer_to_float.h b/onnxruntime/core/providers/neutron/ops/matmul_integer_to_float.h
index 4a975cc40..247313672 100644
--- a/onnxruntime/core/providers/neutron/ops/matmul_integer_to_float.h
+++ b/onnxruntime/core/providers/neutron/ops/matmul_integer_to_float.h
@@ -62,6 +62,7 @@ class MatMulIntegerToFloat final : public MatMulIntegerToFloatBase {
   uint32_t m_b_cols;
   const float  *m_output_bias{NULL};
   std::vector<float> m_out_scale;
+  std::vector<int32_t> m_b_row_sum;
 };
 
 
