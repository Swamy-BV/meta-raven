#!/bin/sh
set -eu
rootdev=$(findmnt -rn -o MAJ:MIN /)
case "$rootdev" in
    "$(cat /sys/class/block/mmcblk0p2/dev)") slot=rootfs_a ;;
    "$(cat /sys/class/block/mmcblk0p4/dev)") slot=rootfs_b ;;
    *) echo "Raven: refusing overlay for unknown root filesystem" >&2; exit 1 ;;
esac
[ "$(findmnt -rn -o MAJ:MIN /overlay)" = "$(cat /sys/class/block/mmcblk0p6/dev)" ] || {
    echo "Raven: overlay partition is not mounted" >&2
    exit 1
}
umask 077
mkdir -p /overlay/slots/"$slot"/upper/var/lib /overlay/slots/"$slot"/workdir/var/lib
chmod 0755 /overlay/slots/"$slot"/upper/var/lib
# Keep each slot's copy-up files and whiteouts out of the other slot.
for layer in upper workdir; do
    [ ! -e /overlay/"$layer" ] || [ -L /overlay/"$layer" ] || {
        echo "Raven: refusing to replace existing overlay directory" >&2
        exit 1
    }
    ln -sfn slots/"$slot"/"$layer" /overlay/"$layer"
done
