       poseIinM.pose.covariance[6 * r + c] = covariance_posori(r, c);
     }
   }
-  pub_poseimu->publish(poseIinM);
+  if (pub_poseimu->get_subscription_count() != 0)
+    pub_poseimu->publish(poseIinM);
