--- a/ov_msckf/src/ros/ROS2Visualizer.cpp
+++ b/ov_msckf/src/ros/ROS2Visualizer.cpp
@@ -151,15 +151,24 @@
 
   // Start thread for the image publishing
   if (_app->get_params().use_multi_threading_pubs) {
-    std::thread thread([&] {
-      rclcpp::Rate loop_rate(20);
-      while (rclcpp::ok()) {
+    publication_thread = std::thread([this] {
+      rclcpp::WallRate loop_rate(20);
+      while (!stopping && rclcpp::ok()) {
         publish_images();
         loop_rate.sleep();
       }
     });
-    thread.detach();
-  }
+  }
+}
+
+ROS2Visualizer::~ROS2Visualizer() { stop(); }
+
+void ROS2Visualizer::stop() {
+  stopping = true;
+  if (update_thread.joinable())
+    update_thread.join();
+  if (publication_thread.joinable())
+    publication_thread.join();
 }
 
