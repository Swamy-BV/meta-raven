From: Raven Contributors <raven@localhost>
Subject: [PATCH] Join estimator workers before destroying ROS resources

Keep asynchronous initialization, image updates and visualization owned by
their objects. Release ROS publishers and plugin objects before the node and
context so shutdown does not depend on static destruction order.

Upstream-Status: Pending
Signed-off-by: Raven Contributors <raven@localhost>
---
--- a/ov_msckf/src/core/VioManager.h
+++ b/ov_msckf/src/core/VioManager.h
@@ -30,6 +30,7 @@
 #include <memory>
 #include <mutex>
 #include <string>
+#include <thread>
 
 #include "VioManagerOptions.h"
 
@@ -67,6 +68,7 @@
    * @param params_ Parameters loaded from either ROS or CMDLINE
    */
   VioManager(VioManagerOptions &params_);
+  ~VioManager();
 
   /**
    * @brief Feed function for inertial data
@@ -224,6 +226,7 @@
 
   // Threads and their atomics
   std::atomic<bool> thread_init_running, thread_init_success;
+  std::thread initialization_thread;
 
   // If we did a zero velocity update
   bool did_zupt_update = false;
--- a/ov_msckf/src/core/VioManager.cpp
+++ b/ov_msckf/src/core/VioManager.cpp
@@ -47,6 +47,11 @@
 using namespace ov_type;
 using namespace ov_msckf;
 
+VioManager::~VioManager() {
+  if (initialization_thread.joinable())
+    initialization_thread.join();
+}
+
 VioManager::VioManager(VioManagerOptions &params_) : thread_init_running(false), thread_init_success(false) {
 
   // Nice startup message
--- a/ov_msckf/src/core/VioManagerHelper.cpp
+++ b/ov_msckf/src/core/VioManagerHelper.cpp
@@ -93,7 +93,9 @@
 
   // Run the initialization in a second thread so it can go as slow as it desires
   thread_init_running = true;
-  std::thread thread([&] {
+  if (initialization_thread.joinable())
+    initialization_thread.join();
+  initialization_thread = std::thread([this] {
     // Returns from our initializer
     double timestamp;
     Eigen::MatrixXd covariance;
@@ -177,12 +179,8 @@
     thread_init_running = false;
   });
 
-  // If we are single threaded, then run single threaded
-  // Otherwise detach this thread so it runs in the background!
   if (!params.use_multi_threading_subs) {
-    thread.join();
-  } else {
-    thread.detach();
+    initialization_thread.join();
   }
   return false;
 }
