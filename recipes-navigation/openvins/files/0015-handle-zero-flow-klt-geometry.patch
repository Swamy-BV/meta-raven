+  // Geometric verification only uses finite tracks that passed optical flow.
   std::vector<cv::Point2f> pts0_n, pts1_n;
+  std::vector<size_t> valid_indices;
+  float maximum_flow = 0.0f;
   for (size_t i = 0; i < pts0.size(); i++) {
-    pts0_n.push_back(camera_calib.at(id0)->undistort_cv(pts0.at(i)));
-    pts1_n.push_back(camera_calib.at(id1)->undistort_cv(pts1.at(i)));
-  }
-
-  // Do RANSAC outlier rejection (note since we normalized the max pixel error is now in the normalized cords)
+    if (i >= mask_klt.size() || !mask_klt[i] || !std::isfinite(pts0[i].x) || !std::isfinite(pts0[i].y) ||
+        !std::isfinite(pts1[i].x) || !std::isfinite(pts1[i].y))
+      continue;
+    pts0_n.push_back(camera_calib.at(id0)->undistort_cv(pts0[i]));
