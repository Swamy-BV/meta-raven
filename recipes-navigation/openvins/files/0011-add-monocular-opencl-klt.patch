+void TrackKLT::prepare_opencl_image(const cv::Mat &input, size_t cam_id, cv::Mat &image,
+                                    std::vector<cv::Mat> &pyramid) {
+  cv::UMat uploaded, prepared;
+  input.copyTo(uploaded);
+  if (histogram_method == HistogramMethod::HISTOGRAM) {
+    cv::equalizeHist(uploaded, prepared);
+  } else if (histogram_method == HistogramMethod::CLAHE) {
+    cv::createCLAHE(10.0, cv::Size(8, 8))->apply(uploaded, prepared);
+  } else {
+    prepared = uploaded;
+  }
+  // Keep the GPU buffer resident for LK. An owned CPU image avoids leaving a
+  // mapped UMat alive while a GPU kernel needs the same allocation.
+  prepared.copyTo(image);
+  pyramid = {image};
+  img_opencl_curr[cam_id] = prepared;
+}
